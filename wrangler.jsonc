{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "restocker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Every request goes through the Worker first, so nothing is served without the login cookie.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resale",
      "database_id": "a17dbdff-46d8-436f-88ab-46759d00e89c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "resale-photos"
    }
  ],
  // Caps login attempts: 5 per minute per IP address.
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
  // Secret (not in this file): SITE_PASSWORD — set with `npx wrangler secret put SITE_PASSWORD`,
  // and for local dev in .dev.vars (see .dev.vars.example).
}
